{
  "name": "record-database",
  "version": "0.1.0",
  "private": true,
  "description": "Getmeds orders app: a sign-in and dashboard per role, with every order kept in its own thread in #order-audit",
  "main": "src/server.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "probe:discord": "node --env-file-if-exists=.env scripts/probe-discord.js",
    "accounts": "node --env-file-if-exists=.env scripts/create-accounts.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
