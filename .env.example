# --- Orbit ---------------------------------------------------------------------
# Orbit is where people, customers, products, prices and the order settings live.
# This app asks for them rather than keeping its own copy, so it needs to know
# where Orbit is. No key or secret here: every call carries the signed-in
# person's own token, and Orbit answers with that person's divisions and teams.
ORBIT_API_URL=http://127.0.0.1:8000

# Where this app's own orders live. It owns these tables and nothing else owns
# them; Orbit reads them and never writes. Written as it will sit in Supabase
# beside Orbit's `core`, so moving it later is this string and nothing more.
# DATABASE_URL=postgresql://user:password@host:5432/orders

# --- Discord (on its way out) ----------------------------------------------------
# Discord was this app's database. It is being replaced by DATABASE_URL above,
# and everything below goes once the orders have been imported across.
# mock = log to the console, never touch the network. live = really post to Discord.
DISCORD_MODE=mock

# Master off switch. Checked on every send, so you can kill posting without a deploy.
DISCORD_ENABLED=false

# A webhook in #order-audit: each order gets a thread there, named with its order id, and one post
# per step saying who did what, and when. Required when DISCORD_MODE=live.
# ROTATE THIS if it has ever been shared. Discord > channel settings > Integrations > Webhooks >
# Delete, then New Webhook.
DISCORD_AUDIT_WEBHOOK_URL=

# Lets the server start each order's thread and read #order-audit back on startup, so orders
# survive a restart. Without it, orders are posted to Discord but kept only in memory.
DISCORD_BOT_TOKEN=

# Most Discord messages to send per minute. Discord allows about 30 per channel.
# Anything over the limit waits in the send queue instead of failing.
DISCORD_MAX_PER_MINUTE=30

# Encrypts customer details (name, contact number, address, receiver, doctor, remarks, notes,
# reasons, payment reference, received-by) and attached files before they're stored in Discord.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up. Lose it and those details can't be read back.
RECORD_SECRET=

# Signs the sign-in cookies. `npm run accounts` adds one. Changing it signs everyone out.
SESSION_SECRET=

# Optional: the accounts, for hosts without a disk (Vercel) until there's a database.
# When set, data/users.json isn't used and the People screen is read-only: add, change or remove
# people here, then restart the server (on Vercel: Settings > Environment Variables, then redeploy).
#   - One account per line: id | email | password | role | name
#   - Roles: admin, salesperson, management, finance, dispatch
#   - The password is plain text (10+ characters) or a scrypt$... hash from data/users.json.
#     Changing someone's password signs them out everywhere.
#   - Never change or reuse an id: orders point at their salesperson by id.
#   - Delete a line, or start it with #, to take someone's access away.
# ACCOUNTS="
# 1 | admin@getmeds.ph | change-this-password | admin | Admin
# 2 | sales@getmeds.ph | change-this-one-too | salesperson | Sales
# "

# Optional: Finance's dashboard flags open orders from this amount (PHP) up for a second look.
# FINANCE_LARGE_ORDER_PHP=100000

# Where accounts (users.json) are kept when ACCOUNTS isn't set, and where old orders (orders.json)
# are imported from. Default: ./data
# DATA_DIR=

# Optional, for `npm run probe:discord`: a webhook in a channel made for testing, not #order-audit.
# The probe posts test messages there and deletes them again.
DISCORD_PROBE_WEBHOOK_URL=

PORT=4000
