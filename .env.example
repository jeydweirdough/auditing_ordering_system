# mock = log to the console, never touch the network. live = really post to Discord.
DISCORD_MODE=mock

# Master off switch. Checked on every send, so you can kill posting without a deploy.
DISCORD_ENABLED=false

# Paste your webhook URL here. Required only when DISCORD_MODE=live.
# ROTATE THIS if it has ever been shared. Discord > channel settings >
# Integrations > Webhooks > Delete, then New Webhook.
DISCORD_WEBHOOK_URL=

# Most Discord messages to send per minute. Discord allows about 30 per channel.
# Anything over the limit waits in the send queue instead of failing.
DISCORD_MAX_PER_MINUTE=30

# Most attachment data per record, in MB. Discord takes 10 MB per message on servers
# without boosts; raise it only if the server's boost level allows more.
DISCORD_MAX_UPLOAD_MB=10

# Optional, for Discord as the database (README, Phase 6). A webhook can only post;
# a bot token lets the server read records back on startup and give each record a thread.
DISCORD_BOT_TOKEN=

# Encrypts customerName and notes before they're stored in Discord. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back it up. Lose it and those fields can't be read back.
RECORD_SECRET=

# Optional, for `npm run probe:discord`: a webhook in a channel made for testing, not the
# records channel. The probe posts test messages there and deletes them again.
DISCORD_PROBE_WEBHOOK_URL=

# The orders app (http://localhost:4000/app). A webhook in #order-audit: each order gets a
# thread there, named with its order id, and one post per step saying who did what, and when.
# Follows DISCORD_MODE and DISCORD_ENABLED like the records; threads need DISCORD_BOT_TOKEN.
DISCORD_AUDIT_WEBHOOK_URL=

# Signs the orders app's sign-in cookies. `npm run accounts` adds one. Changing it signs everyone out.
SESSION_SECRET=

# Where the orders app keeps accounts (users.json) and orders (orders.json). Default: ./data
# DATA_DIR=

PORT=4000
